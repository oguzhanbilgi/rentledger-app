# Bu dosya yalnızca YEREL otomasyon scriptleri içindir (uygulama paketine girmez).
# Uygulamanın herkese açık kimlikleri (RevenueCat public key, AdMob ID'leri) factory.config.js içindedir.
# Gerçek değerleri .env dosyasına yazın — .env git'e eklenmez. Ayrıntılar: scripts/README.md

# RevenueCat v2 GİZLİ anahtarı (npm run setup:revenuecat). ASLA koda veya git'e yazmayın.
RC_SECRET_KEY=
# Birden fazla RevenueCat projesi varsa hangisinin kullanılacağı (isteğe bağlı)
RC_PROJECT_ID=

# Google Play Developer API service account JSON dosyasının yolu (npm run publish:play)
PLAY_SERVICE_ACCOUNT_JSON=
# Yüklenecek .aab dosyası (isteğe bağlı; --aab <yol> ile de verilebilir)
AAB_PATH=
# Yayın kanalı: internal | alpha | beta | production (varsayılan: internal)
PLAY_TRACK=internal
# Mağaza metinleri (varsayılan: store-listing/listing.json)
LISTING_PATH=
